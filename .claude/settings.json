{
  "permissions": {
    "allow": [
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet test*)",
      "PowerShell(dotnet restore*)",
      "PowerShell(dotnet clean*)",
      "PowerShell(dotnet list*)",
      "PowerShell(dotnet format*)",
      "PowerShell(dotnet --*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git config --get*)",
      "PowerShell(gh run list*)",
      "PowerShell(gh run view*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr diff*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh issue view*)",
      "PowerShell(gh issue list*)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(Test-Path*)"
    ],
    "deny": [
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -*)"
    ],
    "ask": [
      "Edit(**/*.csproj)",
      "Write(**/*.csproj)",
      "Edit(**/*.sln)",
      "Write(**/*.sln)",
      "Edit(**/*.slnx)",
      "Write(**/*.slnx)",
      "Edit(**/*.slnf)",
      "Write(**/*.slnf)",
      "Edit(**/Directory.Build.props)",
      "Write(**/Directory.Build.props)",
      "Edit(**/Directory.Packages.props)",
      "Write(**/Directory.Packages.props)",
      "Edit(**/.editorconfig)",
      "Write(**/.editorconfig)",
      "Edit(**/global.json)",
      "Write(**/global.json)",
      "Edit(**/.gitattributes)",
      "Write(**/.gitattributes)",
      "Edit(**/.github/workflows/*.yml)",
      "Write(**/.github/workflows/*.yml)",
      "Edit(**/.github/workflows/*.yaml)",
      "Write(**/.github/workflows/*.yaml)"
    ]
  }
}
