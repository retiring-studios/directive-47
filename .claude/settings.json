{
  "permissions": {
    "ask": [
      "Edit(**/*.csproj)",
      "Write(**/*.csproj)",
      "Edit(**/*.sln)",
      "Write(**/*.sln)",
      "Edit(**/*.slnf)",
      "Write(**/*.slnf)",
      "Edit(**/Directory.Build.props)",
      "Write(**/Directory.Build.props)",
      "Edit(**/Directory.Packages.props)",
      "Write(**/Directory.Packages.props)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 300,
            "statusMessage": "Installing .NET SDK"
          }
        ]
      }
    ]
  }
}
