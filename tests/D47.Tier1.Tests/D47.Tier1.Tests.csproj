<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Tier 1 · Integration, no hardware. WPF layout snapshots, journal parsing
        over fixture logs, synthesized mouse and keyboard input, and the
        vendored SteamVR binding resolving its entry points. None of it needs a
        microphone, a headset or a game, so all of it runs in CI on the same
        windows-latest runner as everything else.

        One project for the tier rather than one per production project. A
        folder per production project inside it is what keeps "where does this
        test live" answerable; the tier is what decides which project.

        net10.0-windows and UseWPF because most of what is in here builds real
        visual trees and walks them; a test that asserts on a view model instead
        would prove the view model, not the rendering. Journal/ needs neither
        and pays for both, which is what one project per tier costs and is
        cheaper than the project it replaces.

        D47.Panel is referenced for its executable as well as its types. Some of
        these tests start D47.Panel.exe as a process, which is the only way to
        assert what the composition root wires together.

        D47.Help is referenced because several of these feed the render a real
        capability's answer rather than a hand-built stand-in. Help is the only
        capability that exists, and it needs no microphone, no network and no
        game.

        xUnit v3, not v2. The SDK's `dotnet new xunit` template still scaffolds
        v2, so this project is hand-written. v3 test projects are executables,
        which is why OutputType is set.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseWPF>true</UseWPF>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\D47.Help\D47.Help.csproj" />
        <ProjectReference Include="..\..\src\D47.Journal\D47.Journal.csproj" />
        <ProjectReference Include="..\..\src\D47.Panel\D47.Panel.csproj" />
        <ProjectReference Include="..\..\src\D47.Render\D47.Render.csproj" />
        <ProjectReference Include="..\..\src\D47.VrOverlay\D47.VrOverlay.csproj" />
        <ProjectReference Include="..\D47.TestSupport\D47.TestSupport.csproj" />
    </ItemGroup>

</Project>
