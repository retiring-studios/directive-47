<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Tier 1. WPF layout, no hardware — so this runs in CI, on the same
        windows-latest runner as everything else. UseWPF is here because the
        tests build real visual trees and walk them; a test that asserts on a
        view model instead would prove the view model, not the rendering.

        These tests came from D47.Panel.Tests unchanged, with the render they
        are about. What stayed behind is everything about being a window.

        xUnit v3, not v2, for the same reason as the other test projects: the
        SDK template still scaffolds v2, and v3 test projects are executables.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseWPF>true</UseWPF>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <!--
        D47.Help is referenced because the rendering tests feed the render a
        real capability's answer rather than a hand-built stand-in. Help is the
        only capability that exists, and it needs no microphone, no network and
        no game.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\D47.Render\D47.Render.csproj" />
        <ProjectReference Include="..\..\src\D47.Help\D47.Help.csproj" />
        <ProjectReference Include="..\D47.TestSupport\D47.TestSupport.csproj" />
    </ItemGroup>

</Project>
