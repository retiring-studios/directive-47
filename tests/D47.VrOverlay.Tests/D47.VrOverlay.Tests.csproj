<Project Sdk="Microsoft.NET.Sdk">

    <!--
        ci.slnf. Nothing in here needs a headset or a running SteamVR: that the
        vendored binding loads and its entry points resolve, and what the render
        looks like as bytes before the compositor ever sees it. Both are facts a
        hosted runner can settle, and both fail the same way on every machine.

        Which is the point of the split. What needs the runtime is
        D47.VrOverlay.HardwareTests — a project whose tests would span two tiers
        is two projects. This one was the whole of it until the headset story
        landed, and the binding tests were written precisely so that a mis-copied
        native binary is caught away from the machine with the headset attached.
        Sitting in hardware.slnf, they were only ever caught on it.

        UseWPF because PanelRenderTests builds the render to get pixels out of
        it, which is a WPF control and RenderTargetBitmap.

        xUnit v3, not v2 — the SDK template still scaffolds v2, and v3 test
        projects are executables.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\D47.VrOverlay\D47.VrOverlay.csproj" />
        <ProjectReference Include="..\D47.TestSupport\D47.TestSupport.csproj" />
    </ItemGroup>

</Project>
