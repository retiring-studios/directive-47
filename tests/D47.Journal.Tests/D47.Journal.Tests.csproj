<Project Sdk="Microsoft.NET.Sdk">

    <!--
        xUnit v3, not v2. Hand-written for the same reason as
        D47.Capabilities.Tests: the SDK template still scaffolds v2, and v3 test
        projects are executables.

        No reference to D47.TestSupport. What lives there is a WPF visual tree
        walker, an STA thread pump and a capability answer, none of which a file
        watcher has any use for — and taking the reference would drag
        net10.0-windows and UseWPF onto a project that needs neither.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\D47.Journal\D47.Journal.csproj" />
    </ItemGroup>

</Project>
