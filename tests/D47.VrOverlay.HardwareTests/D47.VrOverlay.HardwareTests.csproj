<Project Sdk="Microsoft.NET.Sdk">

    <!--
        hardware.slnf only. Everything in here joins a running SteamVR, so there
        is exactly one machine it can run on and no stand-in that would make its
        claims mean anything.

        The second test project for D47.VrOverlay, and the reason is the tier
        rather than the size: a project whose tests would span two tiers is two
        projects. D47.VrOverlay.Tests holds what needs nothing and runs in CI on
        every pull request; this holds what needs the runtime. The alternative
        was one project excluded from ci.slnf, which is what was here before and
        is why the binding tests were only ever run on the machine with the
        headset attached — the one place they were written to save.

        These do not skip when the runtime is absent, the same rule
        D47.GameOverlay.Tests follows: a skip would be a green build that
        checked nothing. See the Test tiers section of docs/decisions.md.
        LookAtTheOverlayTests is the exception and skips by default, because it
        asserts nothing and holds the headset for half a minute.

        xUnit v3, not v2 — the SDK template still scaffolds v2, and v3 test
        projects are executables.
    -->
    <!--
        UseWPF is kept although this project compiles without it. What is left in
        here reaches WPF only through D47.VrOverlay and D47.TestSupport, both of
        which set it, so the framework reference would arrive transitively — in
        theory. It was tried, and it built. Whether the exe still resolves the
        WPF assemblies at run time cannot be settled without SteamVR and a
        headset, and a change nobody can run is not one worth making for two
        removed lines. Drop it the next time somebody is on the dev PC with the
        runtime up and these are green.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\D47.VrOverlay\D47.VrOverlay.csproj" />
        <ProjectReference Include="..\D47.TestSupport\D47.TestSupport.csproj" />
    </ItemGroup>

</Project>
