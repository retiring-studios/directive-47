<Window x:Class="D47.Panel.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:D47.Render;assembly=D47.Render"
        Title="Directive 47"
        AutomationProperties.Name="Directive 47"
        Height="720"
        Width="960">

    <!--
        Deliberately no Background. There is one render, it fills the window, and
        the background is a property of what that render draws — see
        D47.Render/Palette.cs. This window naming one of its own is how it came
        to disagree with the render in the first place.
    -->
    <render:CapabilityView x:Name="View" />

</Window>
