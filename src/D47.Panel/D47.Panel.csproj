<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Tier 1. WPF, so net10.0-windows and Windows-only — but no hardware, so
        its tests run in CI like everything else. hardware.slnf is still waiting
        for the first project that needs a microphone or a headset.

        Named after its only occupant, and that will stop being true. The game
        overlay and the VR overlay present this same render; when the first of
        them arrives the render moves out and this project keeps the window.
        Not moved in advance, because naming a rendering project before there
        are two consumers is guessing at a shape.

        Nullable and the analyzer settings come from Directory.Build.props.
        ImplicitUsings is deliberately off, matching the rest of the repo.
    -->
    <!--
        UseWindowsForms next to UseWPF looks wrong and is not. WPF has no
        notification-area icon of its own, so the choice is WinForms'
        in-box NotifyIcon, a package, or a few hundred lines of Shell_NotifyIcon
        P/Invoke. All three put the same icon in the same place; only the first
        adds nothing to what gets redistributed. See docs/decisions.md.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>

    <!--
        Linked, because assets/ is shared repository content rather than this
        project's own. The Link is what puts it at a stable resource path
        instead of one built out of "..\..\".
    -->
    <ItemGroup>
        <Resource Include="..\..\assets\directive-47.ico" Link="assets\directive-47.ico" />
    </ItemGroup>

    <!--
        The panel is an application, so its types are internal — CA1515, and it
        is right. The tests build real visual trees out of them, which is what
        this opens the door for and the only thing it opens it for.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="D47.Panel.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\D47.Capabilities\D47.Capabilities.csproj" />
        <ProjectReference Include="..\D47.Help\D47.Help.csproj" />
    </ItemGroup>

</Project>
