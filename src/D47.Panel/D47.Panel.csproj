<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Tier 1. WPF, so net10.0-windows and Windows-only â€” but no hardware, so
        its tests run in CI like everything else.

        This is the window, and only the window: showing it, hiding it to the
        tray, and composing what it shows. The render left for D47.Render when
        the game overlay became the second surface to present it, which is the
        move this comment used to say was coming.

        Nullable and the analyzer settings come from Directory.Build.props.
        ImplicitUsings is deliberately off, matching the rest of the repo.
    -->
    <!--
        UseWindowsForms next to UseWPF looks wrong and is not. WPF has no
        notification-area icon of its own, so the choice is WinForms'
        in-box NotifyIcon, a package, or a few hundred lines of Shell_NotifyIcon
        P/Invoke. All three put the same icon in the same place; only the first
        adds nothing to what gets redistributed. See docs/decisions.md.
    -->
    <!--
        StartupObject is what takes the launch away from the entry point WPF
        generates out of App.xaml and gives it to Program.Main. The updater has
        to run before there is an application at all, and App.OnStartup is
        already too late â€” vpk warns about exactly that while packing, and warns
        rather than fails. Drop this line and the build still succeeds, the
        generated Main takes over, and the only symptom is an install that
        misbehaves on somebody else's machine. EntryPointTests is what notices.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <StartupObject>D47.Panel.Program</StartupObject>
    </PropertyGroup>

    <!--
        The mark, everywhere Windows draws it rather than everywhere we do.

        This one property covers the executable in Explorer, the title bar, the
        taskbar button and alt-tab: it compiles the .ico into the executable's
        icon resource, and a WPF window with no Icon of its own falls back to
        the executable's. MainWindow therefore sets no Icon deliberately â€” one
        that did would be a second place to change the mark and a chance for the
        title bar to disagree with the taskbar.

        A different job from the Resource below, on the same file. This is what
        Windows reads with nothing running; that is what the application reads
        at runtime to put an icon in the notification area.
    -->
    <PropertyGroup>
        <ApplicationIcon>..\..\assets\directive-47.ico</ApplicationIcon>
    </PropertyGroup>

    <!--
        Linked, because assets/ is shared repository content rather than this
        project's own. The Link is what puts it at a stable resource path
        instead of one built out of "..\..\".
    -->
    <ItemGroup>
        <Resource Include="..\..\assets\directive-47.ico" Link="assets\directive-47.ico" />
    </ItemGroup>

    <!--
        The panel is an application, so its types are internal â€” CA1515, and it
        is right. The tests reach the window and the application object through
        this, which is what it opens the door for and the only thing it opens it
        for. The render is public and needs none of it.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="D47.Tier1.Tests" />
    </ItemGroup>

    <!--
        The updater. This project and no other: an updater belongs to the
        application that ships, and the libraries below it neither know nor care
        that they are installed rather than copied.
    -->
    <ItemGroup>
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\D47.Composition\D47.Composition.csproj" />
        <ProjectReference Include="..\D47.Data\D47.Data.csproj" />
        <ProjectReference Include="..\D47.GameOverlay\D47.GameOverlay.csproj" />
        <ProjectReference Include="..\D47.Help\D47.Help.csproj" />
        <ProjectReference Include="..\D47.Render\D47.Render.csproj" />
        <ProjectReference Include="..\D47.VoiceLoop\D47.VoiceLoop.csproj" />
        <ProjectReference Include="..\D47.VrOverlay\D47.VrOverlay.csproj" />
    </ItemGroup>

</Project>
