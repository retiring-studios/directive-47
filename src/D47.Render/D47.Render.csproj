<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Tier 1. The one render every visual surface presents — the capability
        view, the template selection that drives it, and the answer it binds to.
        WPF, so net10.0-windows and Windows-only, but no hardware and no game:
        its tests build a visual tree in process and read it back, which a
        hosted runner does as well as a desk does.

        This project is the move D47.Panel.csproj had been advertising in a
        comment since the panel was built. The panel kept the window; the render
        moved out when the game overlay became the second surface to present it.

        A library rather than an application, which is why its types are public.
        CA1515 is right that an application's types should be internal, and
        D47.Panel's still are — being consumed by two other projects is this
        one's whole reason to exist.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\D47.Capabilities\D47.Capabilities.csproj" />
    </ItemGroup>

    <!--
        Saira Condensed, embedded so it is present on a machine that has never
        installed it. Linked, because assets/ is shared repository content rather
        than this project's own; the Link is what puts the font at the stable
        resource path the pack URI in CapabilityView.xaml names.

        Two static faces rather than the variable font: Regular 400 for body,
        SemiBold 600 for anything emphatic.

        OFL.txt is a Resource for the same reason the fonts are. The Open Font
        License requires the license text to travel with the font, and CI
        publishes one self-contained file and attaches only that — so a copy
        sitting next to the exe would not reach anybody.
    -->
    <ItemGroup>
        <Resource Include="..\..\assets\fonts\SairaCondensed-Regular.ttf"
                  Link="assets\fonts\SairaCondensed-Regular.ttf" />
        <Resource Include="..\..\assets\fonts\SairaCondensed-SemiBold.ttf"
                  Link="assets\fonts\SairaCondensed-SemiBold.ttf" />
        <Resource Include="..\..\assets\fonts\OFL.txt" Link="assets\fonts\OFL.txt" />
    </ItemGroup>

</Project>
