<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Tier 0. Help is a capability like any other: it projects the registry
        by template and asserts nothing about the game. Kept out of
        D47.Capabilities so the contract assembly never references a consumer.

        Capabilities share a project. The next Tier 0 capability goes here, not
        into one of its own, and this project gets renamed then — the name is
        accurate today and will not stay that way. Projects split by tier, never
        by capability; see docs/decisions.md.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\D47.Capabilities\D47.Capabilities.csproj" />
    </ItemGroup>

</Project>
