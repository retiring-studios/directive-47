<Project>

    <!--
        Central package versions. ManagePackageVersionsCentrally is set in
        Directory.Build.props, so project files carry PackageReference without
        a Version attribute.
    -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <!--
            Capture and playback, through WASAPI. MIT, managed, and it brings
            exactly one dependency — NAudio.Core, also MIT — which is why
            https://github.com/retiring-studios/directive-47/issues/7 chose it
            over the all-in-one NAudio package. That one adds MIDI, ASIO,
            WinForms and media-format support, none of which anything here
            calls.

            No native binary, so nothing about the single-file publish has to
            change for it, unlike openvr_api.dll.
        -->
        <PackageVersion Include="NAudio.Wasapi" Version="2.3.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <!--
            Windows DPAPI, for the keys the Commander hands over. Microsoft's
            own, MIT, out of the same dotnet/runtime repository as the framework
            — but not in the shared framework, which is what makes this line
            necessary and is the one thing
            https://github.com/retiring-studios/directive-47/issues/221 had
            wrong. Checked on net10.0 and net10.0-windows alike; neither
            resolves ProtectedData without it.

            The alternative was CryptProtectData through LibraryImport, which
            takes no package and does compile. Not taken: seventy lines of
            marshalling and freeing that we would then own, in the one class
            holding the Commander's keys.
        -->
        <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
        <!--
            The updater. MIT, no dependencies. docs/decisions.md settles why it
            is Velopack and what taking it costs: the single-file publish, in
            exchange for per-file patches and a per-user install needing no
            administrator.

            The `vpk` command that builds the installer is pinned to the same
            version in .config/dotnet-tools.json. A library and a tool that
            disagree about the package format is the kind of thing that fails on
            somebody else's machine at install time.
        -->
        <PackageVersion Include="Velopack" Version="1.2.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

</Project>
