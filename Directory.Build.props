<Project>

    <!--
        Deliberately no TargetFramework. A global net10.0-windows would break
        cloud CI, and UseWPF needs the Windows-only Desktop SDK. Tier 0/1
        projects set net10.0; WPF, overlay, and hardware projects set
        net10.0-windows. See docs/decisions.md.

        Deliberately no size or complexity thresholds. Deferred by agreement
        until there is a Tier 2 adapter to calibrate against.
    -->
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

        <!--
            Not cosmetic. IDE0005, the unnecessary-using rule, does not fire
            during build unless documentation generation is on. Long-standing
            Roslyn quirk.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        One literal version, hand-maintained, no dependency. Deriving it from
        git tags means MinVer or Nerdbank.GitVersioning, and a package stops for
        the maintainer; a number in a file does not.

        The cost is that bumping it is a deliberate edit, which is also the
        point. docs/decisions.md has an epic bump at least the minor and a bug
        fix bump the patch, and whether a given epic is major or minor is
        decided when the epic is defined — none of which a tool can infer from
        commit history.

        0.1.0 is the first feature-complete state: help from the capability
        registry. The MVP epic completing is 1.0.0.
    -->
    <PropertyGroup>
        <Version>0.1.2</Version>
    </PropertyGroup>

</Project>
